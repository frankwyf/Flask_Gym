# Flask
SECRET_KEY=replace-with-a-strong-random-secret
DEBUG=false
TESTING=false
STRICT_CONFIG=false
PREFERRED_URL_SCHEME=https
MAX_CONTENT_LENGTH_MB=32

# Reverse proxy (enable when running behind ingress / load balancer)
USE_PROXY_FIX=false
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1
PROXY_FIX_X_HOST=1
PROXY_FIX_X_PORT=1

# Session cookie
SESSION_COOKIE_NAME=flask_gym_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Security headers
ENABLE_SECURITY_HEADERS=true
SECURITY_HEADER_CSP=default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Observability and metrics
ENABLE_STRUCTURED_LOGGING=true
ERROR_LOG_SAMPLE_RATE=0.2
METRICS_ENABLED=true
METRICS_NAMESPACE=flask_gym
METRICS_TOKEN=
METRICS_HISTOGRAM_BUCKETS=0.01,0.025,0.05,0.1,0.25,0.5,1.0,2.5,5.0

# Database
# Default local SQLite (recommended for first run)
DATABASE_URL=sqlite:///instance/flask_gym.db

# To use MySQL instead, comment the line above and use:
# DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/gym

# Mail (optional for password reset)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_SSL=false
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com
